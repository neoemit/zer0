PUBLIC_BASE_URL=https://z.example.com
PORT=3000
TRUST_PROXY=true

# Cloudflare Turnstile protects URL creation. Redirects do not touch CAPTCHA.
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# 62^7 ≈ 3.5T combinations. Increase if you expect huge scale.
CODE_LENGTH=7

# Short URL retention in days. 0 or unset means unlimited retention.
RETENTION_DAYS=0

# Enables admin stats and deletion APIs. Generate a long random value for production.
ADMIN_TOKEN=change-me-long-random-token

# Hot redirects avoid Redis for repeated traffic.
HOT_CACHE_MAX_ENTRIES=100000
HOT_CACHE_TTL_MS=300000
REDIRECT_CACHE_CONTROL=public, max-age=300

# Creation endpoint only. Does not affect redirects.
CREATE_RATE_LIMIT_MAX=20
CREATE_RATE_LIMIT_WINDOW=1 minute
